{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Lawyard changelog",
  "description": "What changed and when. Rendered into CHANGELOG.md. Historical, so evidence paths may no longer exist.",
  "type": "object",
  "required": ["schema", "changelog"],
  "properties": {
    "schema": { "type": "integer", "const": 1 },
    "note": { "type": "string", "maxLength": 400 },
    "changelog": { "type": "array", "items": { "$ref": "#/definitions/entry" } }
  },
  "definitions": {
    "sha": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
    "entry": {
      "type": "object",
      "required": ["id", "date", "type", "title", "detail"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^CH-\\d{3}$" },
        "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "type": { "enum": ["added", "changed", "fixed", "docs", "removed"] },
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "detail": { "type": "string", "minLength": 1, "maxLength": 800 },
        "evidence": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "commits": { "type": "array", "items": { "$ref": "#/definitions/sha" } },
        "changeset": { "type": "array", "items": { "type": "string", "pattern": "^C\\d{2}$" } },
        "defects": { "type": "array", "items": { "type": "string", "pattern": "^D\\d{1,2}$" } }
      }
    }
  }
}
