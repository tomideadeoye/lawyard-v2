{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Lawyard open questions",
  "description": "Things only Tobi can answer. `docs:ask` prints the unanswered ones.",
  "type": "object",
  "required": ["schema", "questions"],
  "properties": {
    "schema": { "type": "integer", "const": 1 },
    "note": { "type": "string", "maxLength": 400 },
    "questions": { "type": "array", "items": { "$ref": "#/definitions/question" } }
  },
  "definitions": {
    "question": {
      "type": "object",
      "required": ["id", "question", "status"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^Q\\d+$" },
        "question": { "type": "string", "minLength": 1 },
        "status": { "enum": ["open", "answered", "parked"] },
        "answer": { "type": ["string", "null"] },
        "from": { "type": "array", "items": { "type": "string", "pattern": "^C\\d{2}$" } },
        "source": { "type": "string" }
      }
    }
  }
}
