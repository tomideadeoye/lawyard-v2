{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Lawyard feature status registry",
  "description": "What is built. Rendered into docs/FEATURE-STATUS.md. Evidence pointers are checked against the filesystem by scripts/docs.mjs.",
  "type": "object",
  "required": ["schema", "features", "launch_checklist"],
  "properties": {
    "schema": { "type": "integer", "const": 1 },
    "verified": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "note": { "type": "string", "maxLength": 400 },
    "features": { "type": "array", "items": { "$ref": "#/definitions/feature" } },
    "launch_checklist": { "type": "array", "items": { "$ref": "#/definitions/launchRow" } }
  },
  "definitions": {
    "status": { "enum": ["shipped", "partial", "scaffolded", "not_started", "specd", "remove", "verify", "parked"] },
    "feature": {
      "type": "object",
      "required": ["id", "name", "status", "evidence"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^F-\\d{2}$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "status": { "$ref": "#/definitions/status" },
        "area": { "type": "string" },
        "tier": { "type": "integer", "minimum": 1, "maximum": 9 },
        "evidence": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "note": { "type": "string", "maxLength": 400 },
        "gap": { "type": "string", "maxLength": 400 },
        "changes": { "type": "array", "items": { "type": "string", "pattern": "^C\\d{2}$" } },
        "defects": { "type": "array", "items": { "type": "string", "pattern": "^D\\d{1,2}$" } }
      }
    },
    "launchRow": {
      "type": "object",
      "required": ["item", "status"],
      "additionalProperties": false,
      "properties": {
        "item": { "type": "string", "minLength": 1, "maxLength": 120 },
        "status": { "$ref": "#/definitions/status" },
        "defects": { "type": "array", "items": { "type": "string", "pattern": "^D\\d{1,2}$" } }
      }
    }
  }
}
