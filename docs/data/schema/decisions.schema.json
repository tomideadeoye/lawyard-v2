{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Lawyard product decisions",
  "description": "Rules the product enforces, why they exist, and who decided. One row per decision; superseding a decision means adding a new row and marking the old one superseded.",
  "type": "object",
  "required": ["schema", "decisions"],
  "properties": {
    "schema": { "type": "integer", "const": 1 },
    "note": { "type": "string", "maxLength": 400 },
    "decisions": { "type": "array", "items": { "$ref": "#/definitions/decision" } }
  },
  "definitions": {
    "decision": {
      "type": "object",
      "required": ["id", "date", "decision", "status", "decided_by"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^PD-\\d{3}$" },
        "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "decision": { "type": "string", "minLength": 1, "maxLength": 240 },
        "rationale": { "type": "string", "maxLength": 800 },
        "status": { "enum": ["active", "proposed", "superseded"] },
        "decided_by": { "type": "string", "minLength": 1, "maxLength": 80 },
        "supersedes": { "type": "string", "pattern": "^PD-\\d{3}$" },
        "affects": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "source": { "type": "string", "maxLength": 200 }
      }
    }
  }
}
