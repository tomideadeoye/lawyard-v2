{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Lawyard changeset registry",
  "description": "Tobi's 12 Sep requests, one row each, with the decision taken. Rendered into docs/TOBI-12SEP-CHANGES.md.",
  "type": "object",
  "required": ["schema", "items"],
  "properties": {
    "schema": { "type": "integer", "const": 1 },
    "call_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "transcript": { "type": "string" },
    "note": { "type": "string", "maxLength": 400 },
    "items": { "type": "array", "items": { "$ref": "#/definitions/item" } },
    "out_of_scope": { "type": "array", "items": { "type": "string" } }
  },
  "definitions": {
    "item": {
      "type": "object",
      "required": ["id", "title", "status", "decision_type", "requested", "decision"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^C\\d{2}$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "status": { "enum": ["shipped", "partial", "scaffolded", "not_started", "specd", "remove", "verify", "parked"] },
        "decision_type": { "enum": ["build", "park", "reject", "confirm", "done"] },
        "requested": { "type": "string", "minLength": 1 },
        "decision": { "type": "string", "minLength": 1 },
        "transcript": { "type": "string" },
        "build_note": { "type": "string" },
        "reviewed": { "type": "boolean" },
        "features": { "type": "array", "items": { "type": "string", "pattern": "^F-\\d{2}$" } },
        "defects": { "type": "array", "items": { "type": "string", "pattern": "^D\\d{1,2}$" } },
        "questions": { "type": "array", "items": { "type": "string", "pattern": "^Q\\d+$" } },
        "alternatives": { "type": "array", "items": { "$ref": "#/definitions/alternative" } }
      }
    },
    "alternative": {
      "type": "object",
      "required": ["option", "why_rejected"],
      "additionalProperties": false,
      "properties": {
        "option": { "type": "string", "minLength": 1, "maxLength": 80 },
        "why_rejected": { "type": "string", "minLength": 1, "maxLength": 200 }
      }
    }
  }
}
