{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Lawyard defect registry",
  "description": "Known product defects. Rendered into docs/FEATURE-STATUS.md §6. Cross-file references (changes/features) are checked by scripts/docs.mjs, not here.",
  "type": "object",
  "required": ["schema", "defects"],
  "properties": {
    "schema": { "type": "integer", "const": 1 },
    "verified": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "note": { "type": "string", "maxLength": 400 },
    "defects": { "type": "array", "items": { "$ref": "#/definitions/defect" } }
  },
  "definitions": {
    "defect": {
      "type": "object",
      "required": ["id", "title", "severity", "status", "impact", "fix", "evidence"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^D\\d{1,2}$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "severity": { "enum": ["high", "medium", "low"] },
        "status": { "enum": ["open", "fixed", "wontfix"] },
        "impact": { "type": "string", "minLength": 1, "maxLength": 240 },
        "fix": { "type": "string", "minLength": 1, "maxLength": 240 },
        "evidence": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "changes": { "type": "array", "items": { "type": "string", "pattern": "^C\\d{2}$" } },
        "features": { "type": "array", "items": { "type": "string", "pattern": "^F-\\d{2}$" } }
      }
    }
  }
}
