{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Lawyard timeline",
  "description": "One record per working session. Rendered into TIMELINE.md.",
  "type": "object",
  "required": ["schema", "sessions"],
  "properties": {
    "schema": { "type": "integer", "const": 1 },
    "note": { "type": "string", "maxLength": 400 },
    "sessions": { "type": "array", "items": { "$ref": "#/definitions/session" } }
  },
  "definitions": {
    "sha": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
    "stringList": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "session": {
      "type": "object",
      "required": ["id", "date"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^S-\\d{4}-\\d{2}-\\d{2}-\\d{2}$" },
        "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "label": { "type": "string", "minLength": 1, "maxLength": 160 },
        "labelStyle": { "enum": ["paren", "dash"] },
        "focus": { "type": "string", "minLength": 1, "maxLength": 400 },
        "whatChanged": { "type": "array", "items": { "$ref": "#/definitions/change" } },
        "rationale": { "$ref": "#/definitions/stringList" },
        "files": { "$ref": "#/definitions/stringList" },
        "blockers": { "$ref": "#/definitions/stringList" },
        "blockersNote": { "type": "string", "minLength": 1 },
        "nextSteps": { "$ref": "#/definitions/stringList" },
        "verification": { "$ref": "#/definitions/stringList" },
        "commits": { "type": "array", "items": { "$ref": "#/definitions/sha" } },
        "changeset": { "type": "array", "items": { "type": "string", "pattern": "^C\\d{2}$" } },
        "defects": { "type": "array", "items": { "type": "string", "pattern": "^D\\d{1,2}$" } }
      }
    },
    "change": {
      "type": "object",
      "required": ["detail"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "sub": { "$ref": "#/definitions/stringList" },
        "detail": { "type": "string", "minLength": 1, "maxLength": 800 }
      }
    }
  }
}
