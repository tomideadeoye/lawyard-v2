{
  "framework": "nextjs",
  "installCommand": "pnpm install",
  "buildCommand": "pnpm build",
  "outputDirectory": ".next",
  "rewrites": [
    {
      "source": "/",
      "destination": "/directory",
      "has": [{ "type": "host", "value": "directory.lawyard.com" }]
    },
    {
      "source": "/:path*",
      "destination": "/directory/:path*",
      "has": [{ "type": "host", "value": "directory.lawyard.com" }]
    }
  ]
}
